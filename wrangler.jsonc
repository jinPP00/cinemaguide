{
  // Cloudflare Workers 정적 자산(Static Assets) 배포 설정.
  //
  // `npm run build`가 만든 out/ 폴더를 그대로 업로드한다.
  // 서버 코드는 없고 정적 파일만 서빙하므로 main 스크립트가 필요하지 않다.
  //
  // 나중에 /go/ 리디렉션이나 문의 폼이 필요해지면 이 설정에 main 진입점을 추가해
  // 같은 Worker에서 처리할 수 있다. (기획서 15.5)
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cinemaguide",
  "compatibility_date": "2026-07-01",
  "assets": {
    "directory": "./out",
    // 없는 주소로 들어오면 out/404.html을 보여준다
    "not_found_handling": "404-page"
  }
}
