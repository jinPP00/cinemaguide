{
  // Cloudflare Workers 정적 자산(Static Assets) 배포 설정.
  //
  // `npm run build`가 만든 out/ 폴더를 그대로 업로드한다.
  // Worker는 HTTP·www 주소만 대표 HTTPS 주소로 옮기고 정적 자산으로 넘긴다.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cinemaguide",
  "main": "worker/index.mjs",
  "compatibility_date": "2026-07-01",
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "run_worker_first": true,
    // 없는 주소로 들어오면 out/404.html을 보여준다
    "not_found_handling": "404-page"
  }
}
