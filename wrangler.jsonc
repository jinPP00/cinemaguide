{
  // Cloudflare Workers 정적 자산(Static Assets) 배포 설정.
  //
  // `npm run build`가 만든 out/ 폴더를 그대로 업로드한다.
  // HTTP→HTTPS는 Cloudflare 도메인의 Always Use HTTPS 설정에서 처리한다.
  // 정적 요청이 Worker 실행 한도에 잡히지 않도록 스크립트를 두지 않는다.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cinemaguide",
  "compatibility_date": "2026-07-01",
  "assets": {
    "directory": "./out",
    // 없는 주소로 들어오면 out/404.html을 보여준다
    "not_found_handling": "404-page"
  }
}
